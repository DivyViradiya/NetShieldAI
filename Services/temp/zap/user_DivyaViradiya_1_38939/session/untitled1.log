/*C5*/INSERT INTO ALERT VALUES(284,0,10023,'Information Disclosure - Debug Error Messages',1,2,'The response appeared to contain common error messages returned by platforms such as ASP.NET, and Web-servers such as IIS and Apache. You can configure the list of common debug messages.','http://testphp.vulnweb.com/showimage.php?file=./pictures/4.jpg','','','Disable debugging messages before pushing to production.','',145,145,'','Internal Server Error',1295,13,3,'','http://testphp.vulnweb.com/showimage.php (file)','10023')
