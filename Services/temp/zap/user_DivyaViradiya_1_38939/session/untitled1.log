/*C5*/INSERT INTO ALERT VALUES(336,0,10036,'Server Leaks Version Information via "Server" HTTP Response Header Field',1,3,'The web/application server is leaking version information via the "Server" HTTP response header. Access to such information may facilitate attackers identifying other vulnerabilities your web/application server is subject to.','http://testphp.vulnweb.com/Mod_Rewrite_Shop/BuyProduct-2/','','','Ensure that your web server, application server, load balancer, etc. is configured to suppress the "Server" header or provide generic details.','https://httpd.apache.org/docs/current/mod/core.html#servertokens\u000ahttps://learn.microsoft.com/en-us/previous-versions/msp-n-p/ff648552(v=pandp.10)\u000ahttps://www.troyhunt.com/shhh-dont-let-your-response-headers/',161,161,'','nginx/1.19.0',497,13,3,'','http://testphp.vulnweb.com/Mod_Rewrite_Shop/BuyProduct-2/','10036-2')
