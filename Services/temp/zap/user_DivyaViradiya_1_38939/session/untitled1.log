/*C5*/INSERT INTO ALERT VALUES(197,0,10037,'Server Leaks Information via "X-Powered-By" HTTP Response Header Field(s)',1,2,'The web/application server is leaking information via one or more "X-Powered-By" HTTP response headers. Access to such information may facilitate attackers identifying other frameworks/components your web application is reliant upon and the vulnerabilities such components may be subject to.','http://testphp.vulnweb.com/listproducts.php?cat=2','','','Ensure that your web server, application server, load balancer, etc. is configured to suppress "X-Powered-By" headers.','https://owasp.org/www-project-web-security-testing-guide/v42/4-Web_Application_Security_Testing/01-Information_Gathering/08-Fingerprint_Web_Application_Framework\u000ahttps://www.troyhunt.com/shhh-dont-let-your-response-headers/',71,71,'','X-Powered-By: PHP/5.6.40-38+ubuntu20.04.1+deb.sury.org+1',497,13,3,'','http://testphp.vulnweb.com/listproducts.php (cat)','10037')
COMMIT
